# Copy this file to .env and fill in your values.
# Get a free Groq API key at https://console.groq.com — no card required.

GROQ_API_KEY=gsk_your_key_here

# ── Optional overrides. Values shown are the actual defaults from
#    config/settings.py; uncomment only to change one.

# Models
# WHISPER_MODEL=whisper-large-v3
# STRUCTURE_MODEL=llama-3.3-70b-versatile
# CONTENT_MODEL=llama-3.1-8b-instant

# Sampling / length
# STRUCTURE_TEMPERATURE=0.3
# CONTENT_TEMPERATURE=0.4
# STRUCTURE_MAX_TOKENS=1500
# CONTENT_MAX_TOKENS=2000

# Limits
# MAX_FILE_SIZE_MB=25          # Groq's audio upload cap
# MAX_TRANSCRIPT_WORDS=120000  # rejects pasted text large enough to stall a run
# MAX_RETRIES=3
# RETRY_DELAY_SECONDS=2.0

# Concurrency — sections are generated in parallel. Groq's free tier
# allows 30 requests/minute, enforced per organisation, so raising this
# makes rate limiting more likely rather than making runs faster.
# MAX_CONCURRENT_SECTIONS=4

# YouTube audio download
# YTDLP_AUDIO_FORMAT=m4a
# YTDLP_AUDIO_QUALITY=5        # 0 best, 9 worst

# Logging
# LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL
